{
	"name": "@medici-uy/js-shared",
	"version": "0.1.8",
	"description": "JS shared utils for medici.uy.",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./reset.css": "./dist/reset.css"
	},
	"scripts": {
		"build": "swc src --out-dir dist --copy-files src/*.css --strip-leading-paths",
		"prebuild": "rm --recursive --force dist && npm run check",
		"postbuild": "tsc",
		"test": "node --test ./dist",
		"check": "biome check --write",
		"tsc": "tsc --noEmit",
		"pretest": "npm run build"
	},
	"dependencies": {
		"@pandacss/preset-base": "2.5.0"
	},
	"peerDependencies": {
		"@pandacss/dev": ">=2.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@pandacss/dev": "2.5.0",
		"@swc/cli": "0.8.2",
		"@swc/core": "1.16.22",
		"@tsconfig/strictest": "2.0.9",
		"@types/debug": "4.1.13",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	},
	"types": "dist/index.d.ts",
	"author": "Diego Stratta <diego@medici.uy>",
	"repository": "git@github.com:medici-uy/js-shared.git",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">= 26.13.0"
	}
}
