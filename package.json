{
	"name": "@medici-uy/js-shared",
	"version": "0.1.5",
	"description": "JS shared utils for medici.uy.",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./reset.css": "./dist/reset.css"
	},
	"scripts": {
		"build": "swc src --out-dir dist --copy-files src/*.css --strip-leading-paths",
		"prebuild": "rm --recursive --force dist && npm run check",
		"postbuild": "tsc",
		"test": "node --test ./dist",
		"check": "biome check --write",
		"tsc": "tsc --noEmit",
		"pretest": "npm run build"
	},
	"peerDependencies": {
		"@pandacss/dev": ">=1.11.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@pandacss/dev": "1.11.4",
		"@swc/cli": "0.8.1",
		"@swc/core": "1.15.43",
		"@tsconfig/strictest": "2.0.8",
		"@types/debug": "4.1.13",
		"@types/node": "26.1.1",
		"typescript": "7.0.2"
	},
	"types": "dist/index.d.ts",
	"author": "Diego Stratta <diego@medici.uy>",
	"repository": "git@github.com:medici-uy/js-shared.git",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">= 26.4.0"
	}
}